# STT and Core_LLM (from Spin_Medical_Assistant_Project)
STT_URL=http://localhost:8000
LLM_URL=http://localhost:8001

HOST=0.0.0.0
PORT=9002
HTTP_TIMEOUT=600

# OpenAI-compatible external provider fallback (STT and/or LLM, "openai:" prefix)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1

# Gemini's own generateContent API (LLM audio input, "gemini:" prefix)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Backend -> controller authentication (required) ---
# Every route except GET / needs this in an X-Internal-Token header.
# Unset means the controller refuses work rather than serving it unprotected.
INTERNAL_API_TOKEN=replace-with-a-long-random-secret

# Largest audio upload accepted, enforced while reading. 50 MB.
MAX_UPLOAD_BYTES=52428800

# --- Version pinning ---
# A job declares which implementation it expects; anything else is refused,
# so a stored result can always be traced to the code that produced it.
SUPPORTED_PREPROCESSING_VERSIONS=legacy-v1
SUPPORTED_PIPELINE_VERSIONS=buali-v1
SUPPORTED_PROMPT_VERSIONS=radiology-v1
