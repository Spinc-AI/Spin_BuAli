# Copy this file to ".env" and adjust as needed. Every value below is
# optional -- the defaults in app/config.py are used when it's absent.

# HOST=0.0.0.0
# PORT=8000
# ALLOWED_ORIGINS=*

# Leave unset to use CUDA when it's available and fall back to CPU otherwise.
# DEVICE=cuda

# Default for POST /transcribe's `language` field ("fa" or "en").
# DEFAULT_LANGUAGE=fa

# Load a model at startup instead of on the first request. Use a key from
# app/config.py's MODEL_REGISTRY, e.g. "whisper" or "seamless".
# PRELOAD_MODEL=
